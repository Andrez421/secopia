# Secopia Web App - Environment Variables
# Copy this file to .env.local and fill in the values

# --- Socrata -------------------------------------------------
# API Token (free from datos.gov.co - recommended for production)
SOCRATA_APP_TOKEN=

# --- AI (Google Gemini) --------------------------------------
# Get API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Upstash Redis (cache + rate limiting) -------------------
# Production: get free tier at https://upstash.com
# Local dev:  docker compose up -d (uses serverless-redis-http proxy)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=dev-token

# --- Typesense (full-text search) ----------------------------
# Production: get free tier at https://cloud.typesense.org
# Local dev:  docker compose up -d
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-key
TYPESENSE_ADMIN_API_KEY=dev-key

# --- Public URL ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
