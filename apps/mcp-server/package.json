{
  "name": "@secopia/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for Secopia via Streamable HTTP",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@secopia/mcp": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
