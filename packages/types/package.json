{
  "name": "@secopia/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types for Secopia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/"
  }
}
